---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Fetch all courses in French, sorting featured ones first, then newest first
const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
const courses = (await getCollection('courses'))
    .filter((course) => course.id.startsWith('fr/'))
    .sort((a, b) => {
        if (a.data.isFeatured && !b.data.isFeatured) return -1;
        if (!a.data.isFeatured && b.data.isFeatured) return 1;
        const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
        const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
        return dateB - dateA;
    });
---

<BaseLayout title="Formations & Éducation" description="Formations de pointe et ateliers pratiques sur la cybersécurité, l'IA et l'informatique quantique." showHeader={false} containerClass="max-w-5xl">
  <section class="mb-16 sm:mb-24">
    <header class="mb-12 border-b border-dashed border-main pb-8">
      <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight mb-4">Éducation</h1>
      <p class="text-lg text-main/80 font-serif italic max-w-2xl">
        Des programmes de pointe, conçus pour combler le fossé entre la R&D académique et la réalité technique de l'industrie.
      </p>
    </header>

    <!-- Courses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {courses.map((course) => {
        const cleanId = course.id.replace(/^fr\//, '');
        const { title, excerpt, duration, format, priceUnique, isFeatured, publishDate } = course.data;
        const publishTime = publishDate ? new Date(publishDate).getTime() : 0;
        const isNew = publishTime > 0 && (Date.now() - publishTime < THIRTY_DAYS_MS);
        
        return (
          <article class={`flex flex-col justify-between p-6 sm:p-8 border rounded-xl relative ${
            isFeatured 
              ? 'border-theme-foreground bg-theme-foreground/5' 
              : 'border-dashed border-main/80'
          }`}>
            <div class="space-y-4">
              <div>
                <div class="flex items-center justify-between gap-3 mb-2">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] sm:text-xs uppercase tracking-wider text-main/60">
                    <span>{duration}</span>
                    <span>•</span>
                    <span>{format}</span>
                  </div>
                  {isNew && (
                    <span 
                      class="new-course-badge shrink-0 px-2.5 py-0.5 text-[10px] uppercase tracking-wider font-medium rounded-full bg-muted text-main border border-main/30"
                      data-publish-date={publishDate ? new Date(publishDate).toISOString() : ''}
                    >
                      Nouvelle formation
                    </span>
                  )}
                </div>
                <h2 class="text-xl sm:text-2xl font-serif font-medium text-main">
                  {title}
                </h2>
              </div>

              <p class="text-sm leading-relaxed text-main/80">
                {excerpt}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-dashed border-main/20 flex items-center justify-between gap-4">
              <div>
                <span class="text-[10px] uppercase tracking-wider text-main/60 block">Tarif</span>
                <strong class="text-base text-main">{priceUnique}</strong>
              </div>
              <Button href={`/education/${cleanId}`} class="text-sm px-4 py-2">
                Découvrir la formation
              </Button>
            </div>
          </article>
        );
      })}

      <!-- Card Prochainement -->
      <article class="flex flex-col justify-between p-6 sm:p-8 border border-dashed border-main/30 rounded-xl relative bg-main/5 opacity-85">
        <div class="space-y-4">
          <div>
            <span class="text-[10px] uppercase tracking-wider text-main/50 block">Prochainement</span>
            <h2 class="text-xl sm:text-2xl font-serif font-medium mt-1.5 text-main/80">
              De nouveaux programmes en préparation
            </h2>
          </div>
          <p class="text-sm leading-relaxed text-main/70">
            D'autres formations s'ajouteront à ce catalogue prochainement. Restez à l'affût ou proposez-moi votre propre sujet d'intérêt.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-dashed border-main/10">
          <a href="/contact" class="inline-block text-xs uppercase tracking-wider font-serif font-medium text-theme-foreground hover:opacity-80 transition-opacity">
            Me proposer un sujet →
          </a>
        </div>
      </article>
    </div>

    <!-- How it works (FAQ) -->
    <div class="mt-24 border-t border-dashed border-main pt-12">
      <h2 class="text-2xl font-serif font-medium mb-8">Comment fonctionne l'inscription ?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm leading-relaxed">
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">1. Pré-inscription sans frais</h3>
          <p class="text-main/80">
            Pour garantir un accompagnement de qualité, nos cohortes disposent de places limitées et nécessitent un nombre minimal de participants (quorum) pour démarrer. Vous pouvez réserver votre place gratuitement en remplissant le formulaire de pré-inscription de la formation choisie.
          </p>
        </div>
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">2. Validation du quorum</h3>
          <p class="text-main/80">
            Dès que le quota requis est atteint pour une session, nous confirmons les dates de la cohorte et vous recevez par courriel votre lien d'inscription final avec les différentes options de facturation Stripe.
          </p>
        </div>
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">3. Facturation officielle & Paiement</h3>
          <p class="text-main/80">
            Le règlement s'effectue via une interface Stripe sécurisée (en un versement ou échelonné selon le cursus). Une facture officielle avec mentions d'entreprise et taxes est automatiquement émise pour vos comptes de dépenses ou budgets de formation employeur (notamment admissible à la Loi sur les compétences au Québec).
          </p>
        </div>
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">4. Accès et documents de bienvenue</h3>
          <p class="text-main/80">
            Une fois le paiement validé, vous recevrez automatiquement vos invitations d'agenda Google Calendar (incluant le lien Google Meet de la classe) ainsi que vos accès complets aux laboratoires virtuels et aux lectures de préparation.
          </p>
        </div>

        <!-- Callout Cohorte Entreprise -->
        <div class="md:col-span-2 mt-4 p-6 rounded-xl border border-dashed border-main/40 bg-muted/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="space-y-1">
            <h3 class="font-serif font-medium text-lg text-main">Besoin d'une cohorte privée en entreprise ?</h3>
            <p class="text-xs text-main/80 leading-relaxed max-w-2xl">
              Vous souhaitez former une équipe complète de développeurs, d'analystes ou d'ingénieurs dans votre organisation ? Nous pouvons organiser une cohorte privée sur mesure, adaptée à vos contextes d'affaires et politiques de sécurité (Loi 25, données souveraines, intégration locale).
            </p>
          </div>
          <Button href="/contact" class="text-xs px-5 py-2.5 shrink-0">
            Demander une cohorte privée
          </Button>
        </div>
      </div>
    </div>
  </section>

  <script>
    function checkNewCourseBadges() {
      const badges = document.querySelectorAll('.new-course-badge[data-publish-date]');
      const now = Date.now();
      const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
      badges.forEach((badge) => {
        const pubDate = badge.getAttribute('data-publish-date');
        if (pubDate) {
          const time = new Date(pubDate).getTime();
          if (now - time > THIRTY_DAYS_MS) {
            badge.remove();
          }
        }
      });
    }
    checkNewCourseBadges();
    document.addEventListener('astro:page-load', checkNewCourseBadges);
  </script>
</BaseLayout>
