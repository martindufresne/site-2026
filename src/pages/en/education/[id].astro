---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/Button.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
    // Map French courses to English routes as a fallback since they are only offered in French
    const courses = (await getCollection('courses'))
        .filter((course) => course.id.startsWith('fr/'));
    
    return courses.map((course) => {
        const cleanId = course.id.replace(/^fr\//, '');
        return {
            params: { id: cleanId },
            props: { course }
        };
    });
}

type Props = { course: CollectionEntry<'courses'> };

const { course } = Astro.props;
const { Content } = await render(course);
const { 
    title, 
    subtitle, 
    excerpt, 
    duration, 
    format, 
    difficulty, 
    priceUnique, 
    priceInstallments,
    seo 
} = course.data;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" showHeader={false}>
    <div class="mb-8">
        <a href="/en/education" class="text-xs uppercase tracking-wider text-main/60 hover:text-main transition-colors flex items-center gap-2">
            ← Back to Education catalog
        </a>
    </div>

    <!-- French delivery notice -->
    <div class="mb-10 bg-amber-500/10 border border-amber-500/20 text-amber-800 dark:text-amber-300 rounded-lg p-4 text-sm leading-relaxed">
        ⚠️ <strong>Language Notice</strong>: This course is currently delivered in <strong>French only</strong>. The course syllabus and materials below are displayed in their original language. If you are interested in an English cohort, please register your interest using the pre-registration button on the sidebar.
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 items-start mb-16">
        <!-- Main Column (Left) -->
        <div class="md:col-span-2">
            <div class="space-y-4 mb-8">
                <span class="inline-block text-xs font-medium uppercase tracking-wider bg-theme-foreground/5 text-theme-foreground px-2.5 py-1 rounded">
                    {format}
                </span>
                <h1 class="text-3xl sm:text-4xl font-serif font-medium leading-tight text-main">
                    {title}
                </h1>
                {subtitle && <p class="text-lg text-main/80 italic font-serif leading-relaxed">{subtitle}</p>}
                <p class="text-base leading-relaxed text-main/70 border-l-2 border-theme-foreground/30 pl-4 py-1">
                    {excerpt}
                </p>
            </div>

            <!-- Markdown Content Rendered -->
            <div class="prose prose-dante max-w-none prose-headings:font-serif prose-headings:font-medium prose-a:text-theme-foreground">
                <Content />
            </div>
        </div>

        <!-- Sidebar (Right) -->
        <div class="md:col-span-1 md:sticky md:top-8 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200/60 dark:border-zinc-800/60 rounded-xl p-6 shadow-sm">
            <div class="space-y-6">
                <div>
                    <span class="text-xs uppercase tracking-wider text-main/60 block mb-1">One-time payment</span>
                    <div class="text-3xl font-bold text-main">{priceUnique}</div>
                    {priceInstallments && (
                        <p class="text-xs text-main/60 mt-1">
                            Or installments: {priceInstallments}
                        </p>
                    )}
                </div>

                <hr class="border-zinc-200 dark:border-zinc-800" />

                <!-- Details Specs List -->
                <div class="space-y-4 text-sm">
                    <div>
                        <strong class="block font-medium text-main">Duration</strong>
                        <span class="text-main/70">{duration}</span>
                    </div>
                    <div>
                        <strong class="block font-medium text-main">Format</strong>
                        <span class="text-main/70">{format}</span>
                    </div>
                    <div>
                        <strong class="block font-medium text-main">Required Level</strong>
                        <span class="text-main/70">{difficulty}</span>
                    </div>
                    <div>
                        <strong class="block font-medium text-main">Certification</strong>
                        <span class="text-main/70">Certificate of Completion awarded</span>
                    </div>
                    <div>
                        <strong class="block font-medium text-main">Payment Options</strong>
                        <span class="text-main/70">1x, 3x, 6x or 12x available</span>
                    </div>
                </div>

                <hr class="border-zinc-200 dark:border-zinc-800" />

                <!-- Registration Widget -->
                <div class="space-y-3" id="pre-reg-container">
                    <div class="bg-theme-foreground/5 text-theme-foreground rounded-lg p-3.5 text-xs leading-relaxed">
                        <strong>Quorum Required</strong>: This cohort will launch once we reach 5 pre-registered participants. Pre-register for free to secure your interest!
                    </div>

                    <form id="pre-reg-form" class="space-y-2.5">
                        <input type="hidden" name="course" value={title} />
                        <input type="hidden" name="locale" value="en" />
                        <div>
                            <label for="reg-name" class="sr-only">Full Name</label>
                            <input 
                                type="text" 
                                id="reg-name" 
                                name="name" 
                                required 
                                placeholder="Your full name" 
                                class="w-full text-xs px-3 py-2 border border-zinc-200 dark:border-zinc-800 rounded bg-transparent text-main focus:outline-none focus:border-theme-foreground transition-colors"
                            />
                        </div>
                        <div>
                            <label for="reg-email" class="sr-only">Email Address</label>
                            <input 
                                type="email" 
                                id="reg-email" 
                                name="email" 
                                required 
                                placeholder="Your email address" 
                                class="w-full text-xs px-3 py-2 border border-zinc-200 dark:border-zinc-800 rounded bg-transparent text-main focus:outline-none focus:border-theme-foreground transition-colors"
                            />
                        </div>
                        <button 
                            type="submit" 
                            class="w-full justify-center text-center bg-theme-foreground text-bg-main font-serif font-medium text-xs py-2 px-4 rounded-lg hover:opacity-90 transition-opacity flex items-center gap-2 cursor-pointer"
                        >
                            <span>Pre-register for free</span>
                        </button>
                    </form>

                    <div id="pre-reg-success" class="hidden bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 rounded-lg p-3.5 text-xs leading-normal">
                        ✓ <strong>Thank you!</strong> Your pre-registration has been recorded. I will contact you as soon as the cohort is confirmed.
                    </div>

                    <div id="pre-reg-error" class="hidden bg-rose-500/10 border border-rose-500/20 text-rose-800 dark:text-rose-300 rounded-lg p-3.5 text-xs leading-normal">
                        ✗ <strong>Error.</strong> Something went wrong. Please try again or contact me directly via email.
                    </div>

                    <p class="text-[10px] text-main/50 text-center leading-normal">
                        No credit card charge. You will receive a payment invoice once the English or French cohort is confirmed.
                    </p>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<script is:inline>
  // Insert your Google Web App URL generated via Apps Script here
  // Example: const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/xxxx/exec";
  const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyaRXBpA8pgoUGTK5em3Ooc_NSU8Nouj4bhUtCMNdLoyQXyMyApNKUHZWpmQDW1UyWa/exec"; 

  function initPreRegistration() {
    const form = document.getElementById('pre-reg-form');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]');
      const btnSpan = submitBtn.querySelector('span');
      const successBox = document.getElementById('pre-reg-success');
      const errorBox = document.getElementById('pre-reg-error');
      
      // Reset status boxes
      successBox.classList.add('hidden');
      errorBox.classList.add('hidden');
      
      // Start loading
      submitBtn.disabled = true;
      const originalText = btnSpan.textContent;
      btnSpan.textContent = "Registering...";
      
      const formData = new FormData(form);
      const params = new URLSearchParams();
      for (const [key, value] of formData.entries()) {
        params.append(key, value);
      }
      
      try {
        if (!GOOGLE_SCRIPT_URL) {
          // Offline simulation for local dev
          console.warn("GOOGLE_SCRIPT_URL is not set. Simulating registration...");
          await new Promise(resolve => setTimeout(resolve, 1200));
        } else {
          const response = await fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            body: params,
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            }
          });
          
          if (!response.ok) throw new Error('Network communication error.');
        }
        
        // Success
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      } catch (err) {
        console.error("Pre-registration error:", err);
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
      } finally {
        btnSpan.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }

  // Astro page transitions compatibility
  document.addEventListener('astro:page-load', initPreRegistration);
</script>
