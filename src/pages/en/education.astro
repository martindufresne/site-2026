---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Fetch all courses. Look for English files first; fallback to French if none exist.
const allCourses = await getCollection('courses');
let courses = allCourses.filter((course) => course.id.startsWith('en/'));
const isFallback = courses.length === 0;

if (isFallback) {
    courses = allCourses.filter((course) => course.id.startsWith('fr/'));
}

// Sort courses: featured ones first
courses.sort((a, b) => {
    if (a.data.isFeatured && !b.data.isFeatured) return -1;
    if (!a.data.isFeatured && b.data.isFeatured) return 1;
    return 0;
});
---

<BaseLayout title="Courses & Education" description="Advanced courses and workshops on cybersecurity, AI, and quantum computing." showHeader={false} containerClass="max-w-5xl">
  <section class="mb-16 sm:mb-24">
    <header class="mb-12 border-b border-dashed border-main pb-8">
      <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight mb-4">Education</h1>
      <p class="text-lg text-main/80 font-serif italic max-w-2xl">
        Cutting-edge training programs, designed to bridge academic research and technical industry needs.
      </p>
    </header>

    {isFallback && (
      <div class="mb-10 bg-amber-500/10 border border-amber-500/20 text-amber-800 dark:text-amber-300 rounded-lg p-4 text-sm leading-relaxed">
        ⚠️ <strong>Notice</strong>: Our training courses are currently delivered in <strong>French only</strong>. You can browse the syllabus details in French by selecting a course below. If you want to request an English cohort, feel free to pre-register.
      </div>
    )}

    <!-- Courses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {courses.map((course) => {
        const cleanId = course.id.replace(/^(fr|en)\//, '');
        const { title, excerpt, duration, format, priceUnique, isFeatured } = course.data;
        
        return (
          <article class={`flex flex-col justify-between p-6 sm:p-8 pt-8 sm:pt-10 border rounded-xl relative ${
            isFeatured 
              ? 'border-theme-foreground bg-theme-foreground/5' 
              : 'border-dashed border-main/80'
          }`}>
            {isFeatured && (
              <span class="absolute -top-3 left-6 px-3 py-0.5 bg-theme-foreground text-bg-main text-[10px] uppercase tracking-widest font-semibold rounded-full">
                Featured
              </span>
            )}
            
            <div class="space-y-4">
              <div>
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] sm:text-xs uppercase tracking-wider text-main/60">
                  <span>{duration}</span>
                  <span>•</span>
                  <span>{format}</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-serif font-medium mt-1.5 text-main">
                  {title}
                </h2>
              </div>

              <p class="text-sm leading-relaxed text-main/80">
                {excerpt}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-dashed border-main/20 flex items-center justify-between gap-4">
              <div>
                <span class="text-[10px] uppercase tracking-wider text-main/60 block">Price</span>
                <strong class="text-base text-main">{priceUnique}</strong>
              </div>
              <Button href={`/en/education/${cleanId}`} class="text-sm px-4 py-2">
                View course details
              </Button>
            </div>
          </article>
        );
      })}
    </div>

    <!-- How it works (FAQ) -->
    <div class="mt-24 border-t border-dashed border-main pt-12">
      <h2 class="text-2xl font-serif font-medium mb-8">How does registration work?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm leading-relaxed">
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">1. Free Pre-Registration</h3>
          <p class="text-main/80">
            To ensure the highest quality experience, our cohorts have limited seats and require a minimum number of participants (quorum) to start. You can reserve your spot for free by filling out the pre-registration form on your selected course page.
          </p>
        </div>
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">2. Quorum Confirmation</h3>
          <p class="text-main/80">
            As soon as the required quorum is met for a session, we confirm the cohort dates and you will receive a final checkout link via email with your Stripe payment options.
          </p>
        </div>
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">3. Payment & Installment Options</h3>
          <p class="text-main/80">
            Payments are processed securely via Stripe. Depending on the duration of the program, you can choose between a one-time payment or flexible monthly installments spread over 3, 6, or 12 months.
          </p>
        </div>
        <div>
          <h3 class="font-serif font-medium text-lg mb-2">4. Calendar Invite & Welcome Materials</h3>
          <p class="text-main/80">
            Once payment is validated, you will automatically receive your Google Calendar invitations (including the Google Meet links for the class) along with welcome emails containing virtual lab accesses and preparation documents.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
